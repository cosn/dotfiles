#!/usr/bin/env swift
import CoreGraphics
import Foundation

func activeDisplays() -> Set<CGDirectDisplayID> {
    var count: UInt32 = 0
    CGGetActiveDisplayList(0, nil, &count)
    var ids = [CGDirectDisplayID](repeating: 0, count: Int(count))
    CGGetActiveDisplayList(count, &ids, &count)
    return Set(ids)
}

func externalDisplayActive() -> Bool {
    activeDisplays().contains { CGDisplayIsBuiltin($0) == 0 }
}

func restartHiddenBar() {
    let kill = Process()
    kill.launchPath = "/usr/bin/killall"
    kill.arguments = ["Hidden Bar"]
    try? kill.run()
    kill.waitUntilExit()

    let open = Process()
    open.launchPath = "/usr/bin/open"
    open.arguments = ["-a", "Hidden Bar"]
    try? open.run()
}

let stableThreshold = 5
var confirmed = externalDisplayActive()
var candidate = confirmed
var stableReads = 0

while true {
    Thread.sleep(forTimeInterval: 1)
    let current = externalDisplayActive()
    if current == candidate {
        stableReads += 1
    } else {
        candidate = current
        stableReads = 1
    }
    if stableReads == stableThreshold && candidate != confirmed {
        if candidate && !confirmed {
            restartHiddenBar()
        }
        confirmed = candidate
    }
}
